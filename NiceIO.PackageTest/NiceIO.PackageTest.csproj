<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <Configurations>Test-Default;Test-Namespace</Configurations>
  </PropertyGroup>

  <!-- when testing namespace replacement -->
  <PropertyGroup Condition="'$(Configuration)'=='Test-Namespace'">
    <DefineConstants>$(DefineConstants);ENABLE_NAMESPACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)'=='Test-Namespace'">
    <PreprocessorValue Include="NICEIO_NAMESPACE" Value="AnotherNamespace" Visible="false" />
  </ItemGroup>

</Project>
